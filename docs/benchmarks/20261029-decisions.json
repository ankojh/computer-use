  "parallel_public_tool_schema": {
    "properties": {
      "state": {
        "$ref": "#/$defs/JsonValue",
        "description": "The subject of the questions, as JSON."
      },
      "questions": {
        "description": "Up to 100 typed questions, keyed by the name each answer comes back under.",
        "maxProperties": 100,
        "minProperties": 1,
        "patternProperties": {
          "^[A-Za-z0-9_-]+$": {
            "discriminator": {
              "mapping": {
                "choice": "#/$defs/GroundedChoiceQuestion",
                "noul": "#/$defs/GroundedNoulQuestion",
                "score": "#/$defs/GroundedScoreQuestion"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/GroundedChoiceQuestion"
              },
              {
                "$ref": "#/$defs/GroundedScoreQuestion"
              },
              {
                "$ref": "#/$defs/GroundedNoulQuestion"
              }
            ]
          }
        },
        "title": "Questions",
        "type": "object"
      },
      "include_excerpts": {
        "default": false,
        "description": "Include each citation's page excerpt in the response. Leave this off unless you need to inspect the evidence for an answer. Excerpts are long, often over 15,000 characters per call. Citation URLs and titles are always returned irrespective of this setting.",
        "title": "Include Excerpts",
        "type": "boolean"
      }
    },
    "required": [
      "state",
      "questions"
    ],
    "type": "object",
    "$defs": {
      "GroundedChoiceQuestion": {
        "properties": {
          "type": {
            "const": "choice",
            "title": "Type",
            "type": "string"
          },
          "instructions": {
            "title": "Instructions",
            "type": "string"
          },
          "criteria": {
            "additionalProperties": {
              "type": "string"
            },
            "maxProperties": 255,
            "minProperties": 2,
            "title": "Criteria",
            "type": "object"
          }
        },
        "required": [
          "type",
          "instructions",
          "criteria"
        ],
        "title": "GroundedChoiceQuestion",
        "type": "object"
      },
      "GroundedNoulCriteria": {
        "properties": {
          "true": {
            "title": "True",
            "type": "string"
          },
          "false": {
            "title": "False",
            "type": "string"
          }
        },
        "required": [
          "true",
          "false"
        ],
        "title": "GroundedNoulCriteria",
        "type": "object"
      },
      "GroundedNoulQuestion": {
        "properties": {
          "type": {
            "const": "noul",
            "title": "Type",
            "type": "string"
          },
          "instructions": {
            "title": "Instructions",
            "type": "string"
          },
          "criteria": {
            "anyOf": [
              {
                "$ref": "#/$defs/GroundedNoulCriteria"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "type",
          "instructions"
        ],
        "title": "GroundedNoulQuestion",
        "type": "object"
      },
      "GroundedScoreQuestion": {
        "properties": {
          "type": {
            "const": "score",
            "title": "Type",
            "type": "string"
          },
          "instructions": {
            "title": "Instructions",
            "type": "string"
          },
          "criteria": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 2,
            "title": "Criteria",
            "type": "array"
          }
        },
        "required": [
          "type",
          "instructions",
          "criteria"
        ],
        "title": "GroundedScoreQuestion",
        "type": "object"
      },
      "JsonValue": {}
    },
